/// 构造一个带消息的 `ValidationError`。
fn validation_error(message: &'static str) -> ValidationError {
    let mut error = ValidationError::new("custom");
    error.message = Some(std::borrow::Cow::Borrowed(message));
    error
}

/// 必填字符串非空校验（挂载到 `String` 必填字段）。
pub fn validate_not_empty(value: &str) -> Result<(), ValidationError> {
    if value.trim().is_empty() {
        Err(validation_error("该字段不能为空"))
    } else {
        Ok(())
    }
}

/// corner 范围校验：min ≤ typ ≤ max（挂载到 `IBISCornerValue` 必填字段）。
pub fn validate_corner(corner: &IBISCornerValue) -> Result<(), ValidationError> {
    validate_corner_inner(corner)
}

/// corner 范围校验（挂载到 `Option<IBISCornerValue>` 字段）。
///
/// validator 0.19 对 `Option<T>` 字段先 `if let Some(ref v)` 解包再取引用，
/// 传给 custom 函数的参数类型为 `&&T`。
pub fn validate_corner_opt(corner: &&IBISCornerValue) -> Result<(), ValidationError> {
    validate_corner_inner(corner)
}

fn validate_corner_inner(corner: &IBISCornerValue) -> Result<(), ValidationError> {
    if corner.min.is_some_and(|min| corner.typ < min) {
        return Err(validation_error("角点顺序违规：typ 小于 min"));
    }
    if corner.max.is_some_and(|max| corner.typ > max) {
        return Err(validation_error("角点顺序违规：typ 大于 max"));
    }
    Ok(())
}

/// IV/VT 曲线单调性校验：电压严格递增（挂载到 `Option<Vec<ViPoint>>` 曲线字段）。
///
/// validator 0.19 对 `Option<T>` 字段传给 custom 函数的参数类型为 `&&T`。
pub fn validate_vi_points(points: &&Vec<ViPoint>) -> Result<(), ValidationError> {
    for pair in points.windows(2) {
        if pair[1].voltage <= pair[0].voltage {
            return Err(validation_error("IV 曲线电压未严格递增"));
        }
    }
    Ok(())
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn test_corner_deserialize_from_text() {
        let v = toml::Value::String("1.12p 0.79p 1.15p".to_string());
        let corner: IBISCornerValue = v.try_into().unwrap();
        assert!((corner.typ - 1.12e-12).abs() < 1e-24);
        assert!((corner.min.unwrap() - 0.79e-12).abs() < 1e-24);
        assert!((corner.max.unwrap() - 1.15e-12).abs() < 1e-24);
    }

    #[test]
    fn test_ratio_corner_deserialize() {
        let v = toml::Value::String("1.9/597p 1.1/792p 1.9/430p".to_string());
        let corner: IBISCornerValue = v.try_into().unwrap();
        assert!(close(corner.typ, 1.9 / 5.97e-10));
        assert!(close(corner.min.unwrap(), 1.1 / 7.92e-10));
        assert!(close(corner.max.unwrap(), 1.9 / 4.3e-10));
    }

    fn close(a: f64, b: f64) -> bool {
        (a - b).abs() <= 1e-12 * a.abs().max(b.abs()).max(1.0)
    }

    #[test]
    fn test_model_roundtrip_through_toml() {
        // 解释器契约：字段名用 snake，数值字段为文本字符串，曲线为行文本数组。
        let toml_str = r#"
            [model]
            model = "IO8FT"
            model_type = "I/O"
            c_comp = "1.12p 0.79p 1.15p"
            vref = "1.8"
            voltage_range = "3.3V 2.0V 3.6V"
            pulldown = ["-3.3 -2mA -2mA -1mA", "0.0 0mA NA NA"]
            ramp.r_load = "1.0000k"
        "#;
        let value: toml::Value = toml::from_str(toml_str).unwrap();
        let model_value = value.get("model").cloned().unwrap();
        let model: IBISModel = model_value.try_into().unwrap();
        assert_eq!(model.model, "IO8FT");
        assert_eq!(model.model_type, "I/O");
        assert!((model.c_comp.as_ref().unwrap().typ - 1.12e-12).abs() < 1e-24);
        assert_eq!(model.vref, Some(1.8));
        assert_eq!(model.voltage_range.as_ref().unwrap().typ, 3.3);
        let pd = model.pulldown.unwrap();
        assert_eq!(pd.len(), 2);
        assert_eq!(pd[0].i_typ, -2.0e-3);
        assert_eq!(model.ramp.as_ref().unwrap().r_load, Some(1000.0));
    }
}
