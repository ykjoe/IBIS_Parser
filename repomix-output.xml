//! value — 数值解析原语与基础数据类型（单一来源）。
//!
//! 集中存放 IBIS 数值 / 单位解析（3.2 §8）与强类型反序列化的基础值类型：
//!
//! - **数值解析原语**：`parse_si_number` / `parse_opt_number` / `parse_opt_f64`，
//!   以及缩放因子 / 基准单位声明；
//! - **serde 反序列化辅助**：`de_opt_f64` / `de_vi_points`（槽位类型 → 解析方式）；
//! - **基础数据类型**：`IBISCornerValue` / `IBISTableData` / `ViPoint`。
//!
//! 这是 `schema::keyword_hierarchy` 强类型领域模型与 backend 数值化解析的公共底座：
//! `keyword_hierarchy` 通过 `pub use super::value::*;` 再导出，保持既有
//! `schema::keyword_hierarchy::*` 路径不变。

use serde::de::Deserializer;
use serde::{Deserialize, Serialize};

// -----------------------------------------------------------------------------
// 数值解析原语（单一来源：本模块；schema::keyword_hierarchy / backend 复用）
// -----------------------------------------------------------------------------

/// SI 前缀 / 单位 / 科学计数法数值解析（IBIS 3.2 §8）。
///
/// 作为强类型反序列化的数值换算原语，供本模块的 serde 属性使用；
/// backend 的数值解析亦委托本函数，避免逻辑重复。
pub fn parse_si_number(input: &str) -> Result<f64, String> {
    let trimmed = input.trim();
    if trimmed.is_empty() {
        return Err("empty numeric value".to_string());
    }

    let bytes = trimmed.as_bytes();
    let mut index = 0;

    // 可选符号。
    if index < bytes.len() && (bytes[index] == b'+' || bytes[index] == b'-') {
        index += 1;
    }

    // 尾数（整数部分 + 可选小数部分）。
    let mut has_digits = false;
    while index < bytes.len() && bytes[index].is_ascii_digit() {
        index += 1;
        has_digits = true;
    }
    if index < bytes.len() && bytes[index] == b'.' {
        index += 1;
        while index < bytes.len() && bytes[index].is_ascii_digit() {
            index += 1;
            has_digits = true;
        }
    }
    if !has_digits {
        return Err(format!("'{trimmed}' has no numeric mantissa"));
    }

    // 可选指数（科学计数法）。
    if index < bytes.len() && (bytes[index] == b'e' || bytes[index] == b'E') {
        index += 1;
        if index < bytes.len() && (bytes[index] == b'+' || bytes[index] == b'-') {
            index += 1;
        }
        let exponent_start = index;
        while index < bytes.len() && bytes[index].is_ascii_digit() {
            index += 1;
        }
        if index == exponent_start {
            return Err(format!("'{trimmed}' has an empty exponent"));
        }
    }

    let numeric_part = &trimmed[..index];
    let suffix = &trimmed[index..];

    let magnitude: f64 = numeric_part
        .parse()
        .map_err(|_| format!("'{trimmed}' is not a valid number"))?;
    Ok(magnitude * scaling_multiplier(suffix)?)
}

/// SI 缩放因子（3.2 §8）：T / G / M / k / m / u / n / p / f。
const SCALING_FACTORS: &[(char, &str, f64)] = &[
    ('T', "tera", 1e12),
    ('G', "giga", 1e9),
    ('M', "mega", 1e6),
    ('k', "kilo", 1e3),
    ('m', "milli", 1e-3),
    ('u', "micro", 1e-6),
    ('n', "nano", 1e-9),
    ('p', "pico", 1e-12),
    ('f', "femto", 1e-15),
];

/// 基准单位（3.2 §8）：伏特 / 安培 / 欧姆 / 法拉 / 亨利 / 秒（含扩展）。
const BASE_UNITS: &[&str] = &["V", "A", "ohm", "Ohm", "F", "H", "W", "Hz", "s"];

/// 解析数值后的后缀：空 / 单字符前缀(+可选单位) / 单位。
fn scaling_multiplier(suffix: &str) -> Result<f64, String> {
    if suffix.is_empty() {
        return Ok(1.0);
    }
    let first_char = suffix.chars().next().expect("suffix is non-empty");
    if let Some((_, _, multiplier)) = SCALING_FACTORS.iter().find(|(symbol, _, _)| *symbol == first_char)
    {
        let unit_part = &suffix[first_char.len_utf8()..];
        if !unit_part.is_empty() && !is_valid_unit(unit_part) {
            return Err(format!("unknown unit '{unit_part}'"));
        }
        Ok(*multiplier)
    } else if is_valid_unit(suffix) {
        Ok(1.0)
    } else {
        Err(format!("unknown unit suffix '{suffix}'"))
    }
}

/// 是否是合法单位缩写。
fn is_valid_unit(unit: &str) -> bool {
    BASE_UNITS.contains(&unit)
}

/// 解析一个可选数值：空 / `NA` → `None`；否则换算为 `f64` → `Some`。
///
/// 支持比值（`a/b`，如 Ramp 的 `1.9/597p`）：分子 / 分母分别按 SI 数值换算。
fn parse_opt_number(text: &str) -> Option<f64> {
    let trimmed = text.trim();
    if trimmed.is_empty() || trimmed.eq_ignore_ascii_case("NA") {
        return None;
    }
    if trimmed.contains('/') {
        let (numerator, denominator) = trimmed.split_once('/')?;
        let numerator = parse_si_number(numerator.trim()).ok()?;
        let denominator = parse_si_number(denominator.trim()).ok()?;
        if denominator == 0.0 {
            return None;
        }
        return Some(numerator / denominator);
    }
    parse_si_number(trimmed).ok()
}

/// 解析一个可选数值（backend 解构阶段用）：空 / `NA` → `Ok(None)`；非法 → `Err`。
pub fn parse_opt_f64(text: &str) -> Result<Option<f64>, String> {
    let trimmed = text.trim();
    if trimmed.is_empty() || trimmed.eq_ignore_ascii_case("NA") {
        return Ok(None);
    }
    parse_si_number(trimmed).map(Some)
}

// -----------------------------------------------------------------------------
// serde 反序列化辅助（挂载到强类型字段，作为"槽位类型 → 解析方式"的声明）
// -----------------------------------------------------------------------------

/// 从解释器产出的文本解析 `Option<f64>`（空 / `NA` → `None`；含 SI 前缀换算）。
pub fn de_opt_f64<'de, D>(d: D) -> Result<Option<f64>, D::Error>
where
    D: Deserializer<'de>,
{
    let text: Option<String> = Option::deserialize(d)?;
    Ok(text.as_deref().and_then(parse_opt_number))
}

/// 从解释器产出的曲线行列表解析 `Option<Vec<ViPoint>>`。
///
/// 每行 4 列 `voltage i_typ i_min i_max`；`NA` / 空电流列 → `None`。
pub fn de_vi_points<'de, D>(d: D) -> Result<Option<Vec<ViPoint>>, D::Error>
where
    D: Deserializer<'de>,
{
    let lines: Option<Vec<String>> = Option::deserialize(d)?;
    match lines {
        Some(lines) => {
            let mut points = Vec::new();
            for line in &lines {
                let cols: Vec<&str> = line.split_whitespace().collect();
                // 畸形行（列数不足 4）宽松跳过，不中断整体反序列化。
                if cols.len() < 4 {
                    continue;
                }
                points.push(ViPoint {
                    voltage: parse_si_number(cols[0]).unwrap_or(0.0),
                    i_typ: parse_si_number(cols[1]).unwrap_or(0.0),
                    i_min: parse_opt_number(cols[2]),
                    i_max: parse_opt_number(cols[3]),
                });
            }
            Ok(Some(points))
        }
        None => Ok(None),
    }
}

// -----------------------------------------------------------------------------
// 基础数据类型（triplet / table 抽象）
// -----------------------------------------------------------------------------

/// 角点三元组：typ / min / max（triplet 抽象）。
///
/// 数值化后 `typ` 必填，`min` / `max` 缺失或 `NA` → `None`。
///
/// 反序列化契约：解释器产出的文本三元组（如 `"3.3V 2.0V 3.6V"` 或
/// `"1.12p 0.79p 1.15p"`）→ `typ / min / max`。
#[derive(Debug, Clone, PartialEq, Default, Serialize)]
pub struct IBISCornerValue {
    pub typ: f64,
    pub min: Option<f64>,
    pub max: Option<f64>,
}

impl<'de> Deserialize<'de> for IBISCornerValue {
    fn deserialize<D>(d: D) -> Result<Self, D::Error>
    where
        D: Deserializer<'de>,
    {
        let text: String = String::deserialize(d)?;
        let tokens: Vec<&str> = text.split_whitespace().collect();
        // 宽松解析：坏值以 0.0 / None 占位，不中断整体反序列化。
        let typ = tokens.first().copied().and_then(parse_opt_number).unwrap_or(0.0);
        // IBIS 3.2 §8：`typ min max` 与 `typ max min` 两种书写顺序均合法（min/max 以
        // 任意顺序出现），解析时按**数值大小**归一化：min = 较小者，max = 较大者。
        let bound1 = tokens.get(1).copied().and_then(parse_opt_number);
        let bound2 = tokens.get(2).copied().and_then(parse_opt_number);
        let min = match (bound1, bound2) {
            (Some(a), Some(b)) => Some(a.min(b)),
            (Some(a), None) | (None, Some(a)) => Some(a),
            (None, None) => None,
        };
        let max = match (bound1, bound2) {
            (Some(a), Some(b)) => Some(a.max(b)),
            (Some(a), None) | (None, Some(a)) => Some(a),
            (None, None) => None,
        };
        Ok(IBISCornerValue { typ, min, max })
    }
}

/// 通用表格数据（table 抽象）：首行列头，其余行为数值行。
///
/// 反序列化契约：解释器产出的 `{ columns = [...], rows = [[...]] }`。
#[derive(Debug, Clone, PartialEq, Default, Serialize, Deserialize)]
pub struct IBISTableData {
    pub columns: Vec<String>,
    pub rows: Vec<Vec<f64>>,
}

/// I-V / V-T 曲线数据点（表格的特化形态）。
///
/// 每行 4 列 `voltage i_typ i_min i_max` → 一个 [`ViPoint`]；`NA` 电流列 → `None`。
#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
pub struct ViPoint {
    pub voltage: f64,
    pub i_typ: f64,
    pub i_min: Option<f64>,
    pub i_max: Option<f64>,
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn test_parse_si_number() {
        assert_eq!(parse_si_number("0.1").unwrap(), 0.1);
        assert_eq!(parse_si_number("-3.3000").unwrap(), -3.3);
        assert_eq!(parse_si_number("1.12p").unwrap(), 1.12e-12);
        assert_eq!(parse_si_number("2.0000mA").unwrap(), 2.0e-3);
        assert_eq!(parse_si_number("3.3V").unwrap(), 3.3);
        // 比值（a/b）不是 parse_si_number 的语法，应报错。
        assert!(parse_si_number("1.9/597p").is_err());
        assert!(parse_si_number("abc").is_err());
    }

    #[test]
    fn test_parse_opt_f64_plain() {
        assert_eq!(parse_opt_f64("0.1").unwrap(), Some(0.1));
        assert_eq!(parse_opt_f64("-3.3000").unwrap(), Some(-3.3));
    }

    #[test]
    fn test_parse_opt_f64_prefix_and_unit() {
        assert_eq!(parse_opt_f64("1.12p").unwrap(), Some(1.12e-12));
        assert_eq!(parse_opt_f64("2.0000mA").unwrap(), Some(2.0e-3));
        assert_eq!(parse_opt_f64("3.3V").unwrap(), Some(3.3));
        assert_eq!(parse_opt_f64("0.1250k").unwrap(), Some(125.0));
    }

    #[test]
    fn test_parse_opt_f64_na_and_empty() {
        assert_eq!(parse_opt_f64("NA").unwrap(), None);
        assert_eq!(parse_opt_f64("na").unwrap(), None);
        assert_eq!(parse_opt_f64("").unwrap(), None);
        assert_eq!(parse_opt_f64("   ").unwrap(), None);
    }

    #[test]
    fn test_parse_opt_f64_invalid() {
        assert!(parse_opt_f64("abc").is_err());
        assert!(parse_opt_f64("1x").is_err());
    }
}
